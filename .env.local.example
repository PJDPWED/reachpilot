# ============================================================
# ReachPilot — Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-here

# ── Google OAuth2 (Gmail API) ────────────────────────────────
# Create credentials at: https://console.cloud.google.com
# Enable Gmail API, then create OAuth2 credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── Supabase ─────────────────────────────────────────────────
# Create project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cron Security ────────────────────────────────────────────
# A secret header value to protect cron endpoints
CRON_SECRET=your-random-cron-secret-key
